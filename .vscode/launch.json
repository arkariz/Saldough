    "version": "0.2.0",
    "configurations": [
        {
            "name": "Saldough (debug · Plus)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=PLAN_OVERRIDE=plus"]
        },
        {
            "name": "Saldough (debug · Gratis)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=PLAN_OVERRIDE=free"]
        },
        {
            "name": "Saldough (debug · Trial)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=PLAN_OVERRIDE=trial"]
        },
        {
            "name": "Saldough (Plus sandbox)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--dart-define-from-file=dart_defines.local.json"]
        },
        {
            "name": "Saldough (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "Saldough (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
