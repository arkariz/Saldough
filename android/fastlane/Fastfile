require 'fileutils'
require 'json'

default_platform(:android)

# Kunci SDK RevenueCat (publik) untuk build (ADR-041 §3.5, P-6). Rilis DAN
# patch harus membawanya: patch tanpa kunci membuang pembelian dari build
# yang terpasang. Tanpa secret, build berjalan tanpa RevenueCat (hak hanya
# dari uji coba dan pra-peluncuran).
def revenuecat_args
    key = ENV["REVENUECAT_ANDROID_KEY"].to_s.strip
    if key.empty?
        UI.important("REVENUECAT_ANDROID_KEY kosong: build tanpa RevenueCat")
        return ""
    end
    # Kunci Test Store (`test_…`) tidak boleh masuk build yang dipublikasikan;
    # pembelian sungguhan hanya lewat kunci Play (`goog_…`).
    unless key.start_with?("goog_")
        UI.user_error!("REVENUECAT_ANDROID_KEY bukan kunci Play (goog_…): kunci test_ hanya untuk build debug")
    end
    "-- --dart-define=REVENUECAT_ANDROID_KEY=#{key}"
end

platform :android do

    desc "Shorebird Release dan Upload ke Play Store Internal"
    lane :release_internal do
        shorebird_release(platform: "android", args: revenuecat_args)

        # 1. Catatan "What's new" Play dari berkas catatan yang sama dengan
        # aplikasi (ADR-039 §3.3), diformat skrip catatan: judul, kategori
        # beremoji, butir bertanda •, maksimal 500 karakter (batas Play).
        build = File.read("../../pubspec.yaml", encoding: "UTF-8")[/^version:\s*\S+\+(\d+)/, 1]
        changelog = lambda do |lang|
            text = `node ../../scripts/release_notes.js play-changelog --build #{build} --lang #{lang}`.force_encoding("UTF-8")
            UI.user_error!("Gagal membuat catatan Play (#{lang})") unless $?.success? && !text.strip.empty?
            text
        end
        note_id = changelog.call("id")
        note_en = changelog.call("en")

        # 2. Create Fastlane metadata folder structure dynamically
        id_dir = "metadata/android/id/changelogs"
        en_dir = "metadata/android/en-US/changelogs"
        
        FileUtils.mkdir_p(id_dir)
        FileUtils.mkdir_p(en_dir)

        # 3. Save text to default.txt file for automatic read to all version code
        File.write("#{id_dir}/default.txt", note_id)
        File.write("#{en_dir}/default.txt", note_en)

        # 4. Upload to Google Play Store (Internal Track)
        upload_to_play_store(
            track: "internal",
            aab: "../build/app/outputs/bundle/release/app-release.aab",
            skip_upload_metadata: false, 
            skip_upload_images: true,
            skip_upload_screenshots: true,
            changes_not_sent_for_review: true
        )
    end

    desc "Shorebird Patch (OTA Update)"
    lane :patch_ota do
        shorebird_patch(
            platform: "android",
            args: "--release-version=latest --allow-asset-diffs #{revenuecat_args}".strip
        )
    end

end